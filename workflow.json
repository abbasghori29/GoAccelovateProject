{
  "name": "Job Search Workflow",
  "nodes": [
    {
      "parameters": {
        "authentication": "apiKey",
        "operation": "search",
        "path": "/api/search"
      },
      "name": "Job Search API",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300],
      "credentials": {
        "apiKey": "SCRAPINGDOG_API_KEY"
      }
    },
    {
      "parameters": {
        "operation": "scrapeJobs",
        "sources": ["linkedin", "google"]
      },
      "name": "Job Scraper",
      "type": "custom.jobScraper",
      "typeVersion": 1,
      "position": [300, 300]
    },
    {
      "parameters": {
        "operation": "processResults",
        "matchingCriteria": {
          "position": 40,
          "location": 20,
          "skills": 30,
          "experience": 10
        }
      },
      "name": "Result Processor",
      "type": "custom.resultProcessor",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "operation": "displayResults",
        "format": "cards",
        "sorting": "matchScore"
      },
      "name": "Display Handler",
      "type": "custom.displayHandler",
      "typeVersion": 1,
      "position": [700, 300]
    }
  ],
  "connections": {
    "Job Search API": {
      "main": [
        [
          {
            "node": "Job Scraper",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Job Scraper": {
      "main": [
        [
          {
            "node": "Result Processor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Result Processor": {
      "main": [
        [
          {
            "node": "Display Handler",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "timezone": "default"
  },
  "staticData": {},
  "tags": ["job-search", "automation"],
  "triggerCount": 0,
  "updatedAt": "2024-03-17T12:00:00.000Z",
  "versionId": "1.0.0"
} 